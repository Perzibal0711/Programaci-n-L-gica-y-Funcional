;; Pedir que se quiere obtener un volumen o una area
(defun ask-option ()
    (format t "Introduce 1 si quieres calcular areas,~%Introduce 2 si quieres obtener volumenes.~%Introduce 3 si quieres salir~%Opcion: ")
    (let ((opt (read)))
        (if (numberp opt)
            (case opt
                (1 
                    (opt-area)
                    (ask-option)
                )
                (2 
                    (opt-volum)
                    (ask-option)
                )
                (3 
                    "Adios 0_0"
                )
                (otherwise 
                    (ask-option)
                )
            )
            (ask-option)
        )
    )
)

(defun opt-area()
    (format t "~%Selecciona la figura~%1.  Cubo~%2.  Cuadrado~%3.  Rectangulo~%4.  Pentagono~%5.  Rombo~%6.  Romboide~%7.  Trapecio~%8.  Triangulo~%9.  Circulo~%10. Cilindro~%11. Regresar al menu~%De cual quieras obtener el area: ")
    (let ((area (read)))
        (format t "~%")
        (if (numberp area)
            (case area
                (1 
                    (format t "Ingrese la longitud de uno de sus lados: ")
                    (let ((l (read)))
                        (format t "El area es: ~A~%" (a_cubo l))
                    )  
                )
                (2 
                    (format t "Ingrese la longitud de uno de sus lados: ")
                    (let ((l (read)))
                        (format t "El area es: ~A~%" (a_cuadrado l))
                    )
                )
                (3 
                    (format t "Ingrese la longitud su base: ")
                    (let ((b (read)))
                        (format t "Ingrese la longitud de la altura: ")
                        (let ((h (read)))
                            (format t "El area es: ~A~%" (a_rectangulo b h))
                        )
                    )
                )
                (4 
                    (format t "Ingrese el perimetro de la figura: ")
                    (let ((p (read)))
                        (format t "Ingrese el apotema de la figura: ")
                        (let ((a (read)))
                            (format t "El area es: ~A~%" (a_pentagono p a))
                        )
                    )  
                )
                (5 
                    (format t "Ingrese la longitud de la diagonal mayor: ")
                    (let ((d_ma (read)))
                        (format t "Ingrese la longitud de la diagonal menor: ")
                        (let ((d_me (read)))
                            (format t "El area es: ~A~%" (a_rombo d_ma d_me))
                        ) 
                    )
                )
                (6 
                    (format t "Ingrese la longitud su base: ")
                    (let ((b (read)))
                        (format t "Ingrese la longitud de la altura: ")
                        (let ((h (read)))
                            (format t "El area es: ~A~%" (a_romboide b h))
                        )
                    )
                )
                (7 
                    (format t "Ingrese la longitud su base mayor: ")
                    (let ((b_ma (read)))
                        (format t "Ingrese la longitud su base menor: ")
                        (let ((b_me (read)))
                            (format t "Ingrese la longitud de la altura: ")
                            (let ((h (read)))
                                (format t "El area es: ~A~%" (a_trapecio b_ma b_me h))
                            )
                        )
                    )
                )
                (8 
                    (format t "Ingrese la longitud su base: ")
                    (let ((b (read)))
                        (format t "Ingrese la longitud de la altura: ")
                        (let ((h (read)))
                            (format t "El area es: ~A~%" (a_triangulo b h))
                        )
                    )
                )
                (9 
                    (format t "Ingrese el radio: ")
                    (let ((r (read)))
                        (format t "El area es: ~A~%" (a_circulo r))
                    )
                )
                (10 
                    (format t "Ingrese el radio: ")
                    (let ((r (read)))
                        (format t "Ingrese la longitud de la altura: ")
                        (let ((h (read)))
                            (format t "El area es: ~A~%" (a_cilindro r h))
                        )
                    )
                )
                (11 
                    nil
                )
                (otherwise 
                    (format t "Opcion no valida")
                )
            )
            (format t "Debes introducir un numero")
        )
        (format t "~%")
        (if (and (numberp area) (/= area 11))
            (opt-area)
        )
    )
)

(defun opt-volum()
